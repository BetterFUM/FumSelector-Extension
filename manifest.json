{
  "manifest_version": 3,
  "name": "FumSelector Extension",
  "description": "A clean light-mode view for Pooya's eligible course groups.",
  "version": "1.3.0",
  "host_permissions": ["https://pooya.um.ac.ir/*"],
  "content_scripts": [
    {
      "matches": ["https://pooya.um.ac.ir/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/Vazirmatn.woff2"],
      "matches": ["https://pooya.um.ac.ir/*"]
    }
  ]
}
